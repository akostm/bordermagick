#!/usr/bin/env bash
# bordermagick — border + wider bottom strip: photo title on the left, maker logo and camera info on the right
# Run "bordermagick -h" for options.
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"   # needed when run from Automator/Shortcuts

# Data folder (override with BORDERMAGICK_HOME); logos are cached / user-supplied in logos/<maker>.png
BM_HOME="${BORDERMAGICK_HOME:-$HOME/.bordermagick}"
LOGO_DIR="$BM_HOME/logos"
# DIN Alternate ships in Bold only, and lacks "·" (U+00B7) — use "∙" (U+2219) instead
FONT="/System/Library/Fonts/Supplemental/DIN Alternate Bold.ttf"
FONT_COND="/System/Library/Fonts/Supplemental/DIN Condensed Bold.ttf"   # film edge print
AMBER="#F2B134"                                                        # contact-sheet ink
SERIF="/System/Library/Fonts/Supplemental/Georgia"                     # museum label: + .ttf / Bold / Italic
SEP="∙"

# The script's own folder (through symlinks, e.g. a link in /usr/local/bin), for lib/ and layouts/
src=$0
while [[ -L "$src" ]]; do
  dir=$(cd -P "$(dirname "$src")" && pwd); src=$(readlink "$src"); [[ "$src" == /* ]] || src="$dir/$src"
done
BM_DIR=$(cd -P "$(dirname "$src")" && pwd)
for lib in tags layout engine; do
  [[ -f "$BM_DIR/lib/$lib.sh" ]] || { echo "bordermagick: $BM_DIR/lib/$lib.sh is missing (keep lib/ next to the script)" >&2; exit 2; }
  . "$BM_DIR/lib/$lib.sh"
done
# Your own layouts first, then the built-in ones (BORDERMAGICK_LAYOUTS: an extra folder in front, for tests)
LAYOUT_PATH="${BORDERMAGICK_LAYOUTS:+$BORDERMAGICK_LAYOUTS:}$BM_HOME/layouts:$BM_DIR/layouts"

TMP=$(mktemp -d)
trap 'rm -f "$TMP"/*; rmdir "$TMP"' EXIT

# Some macOS typefaces live in collection files (.ttc) holding several weights; ImageMagick can only pick
# one of those through its font registry. Register the faces we use in a private type.xml (face = index
# in the collection) and point ImageMagick at it. Used as -font HelveticaNeue-Bold etc.
cat > "$TMP/type.xml" <<'XML'
<?xml version="1.0" encoding="UTF-8"?>
<typemap>
  <type name="HelveticaNeue-Bold"   glyphs="/System/Library/Fonts/HelveticaNeue.ttc" face="1"/>
  <type name="HelveticaNeue-Medium" glyphs="/System/Library/Fonts/HelveticaNeue.ttc" face="10"/>
  <type name="Futura-CondExtraBold" glyphs="/System/Library/Fonts/Supplemental/Futura.ttc" face="4"/>
</typemap>
XML
export MAGICK_CONFIGURE_PATH="$TMP"

# Testing hook: BORDERMAGICK_SEED fixes the random textures (marble, terrazzo, linen, frost, paper),
# so renders are reproducible pixel for pixel. mg = magick with that seed applied.
SEEDOPT=()
if [[ -n "${BORDERMAGICK_SEED:-}" ]]; then SEEDOPT=( -seed "$BORDERMAGICK_SEED" ); RANDOM=$BORDERMAGICK_SEED; fi
mg() { magick ${SEEDOPT[@]+"${SEEDOPT[@]}"} "$@"; }

# Procedural border materials, rendered to $4 at $2 x $3 px
material() {
  local name=$1 w=$2 h=$3 out=$4
  local s=$(( w < h ? w : h ))
  case "$name" in
    marble*)
      local vein stone
      case "$name" in
        marble)       vein="#7D7F86"; stone="#F4F2EE" ;;   # white Carrara, grey veins
        marble-dark)  vein="#A8A39B"; stone="#1B1B1D" ;;   # Nero Marquina, pale veins
        marble-green) vein="#D7E3D9"; stone="#1F3B33" ;;   # verde, pale veins
        marble-beige) vein="#A0815C"; stone="#EDE3CF" ;;   # Crema Marfil, soft golden-brown veins
      esac
      # Diagonal sine bands warped by fractal turbulence and sharpened into veins, plus a finer hairline
      # layer and faint cloudiness. Turbulence is made at a fixed small size so the look doesn't depend on
      # resolution; the vein maths runs at 1/3 size and is scaled up.
      local tw=300 th=$(( 300 * h / w )) ww=$(( w / 3 )) wh=$(( h / 3 ))
      mg -size ${tw}x${th} plasma:fractal -colorspace gray -blur 0x3 -auto-level -resize ${ww}x${wh}\! "$TMP/turb.png"
      magick "$TMP/turb.png" -fx "pow(abs(sin((i/w*2.2 + j/h*1.3)*pi + u*7)), 0.22)" "$TMP/main.png"
      mg -size ${tw}x${th} plasma:fractal -colorspace gray -blur 0x2 -auto-level -resize ${ww}x${wh}\! \
        -fx "pow(abs(sin((i/w*5 - j/h*3)*pi + u*11)), 0.12)" "$TMP/fine.png"
      magick "$TMP/main.png" \( "$TMP/fine.png" +level 45%,100% \) -compose multiply -composite \
        \( "$TMP/turb.png" +level 88%,100% \) -compose multiply -composite \
        -resize ${w}x${h}\! +level-colors "$vein,$stone" "$out" ;;
    terrazzo)
      # Angular stone chips as random irregular polygons on a cream base (crisp at any resolution)
      awk -v w=$w -v h=$h -v s=$s -v seed=$RANDOM -v clear="${CLEAR:-}" 'BEGIN {
        srand(seed); pi = 3.14159265
        n = split("#C9826B #C9826B #7E8C7A #7E8C7A #3F3F44 #D9B26F #B9B2A6 #B9B2A6 #E3D5C3", col, " ")
        nz = split(clear, z, " ")                         # keep-clear boxes "x0,y0,x1,y1"
        chips = int(w * h / (s * s) * 1300)
        for (k = 0; k < chips; k++) {
          r = s * (0.0025 + 0.011 * rand() ^ 3)           # mostly small, a few large
          cx = rand() * w; cy = rand() * h
          hit = 0
          for (q = 1; q <= nz; q++) { split(z[q], c, ",")
            if (cx + r > c[1] && cx - r < c[3] && cy + r > c[2] && cy - r < c[4]) hit = 1 }
          if (hit) continue
          v = 4 + int(rand() * 4); a0 = rand() * 2 * pi  # 4-7 corners, random rotation
          printf "fill %s polygon", col[1 + int(rand() * n)]
          for (i = 0; i < v; i++) {
            a = a0 + i * 2 * pi / v + (rand() - 0.5) * 0.9; rr = r * (0.55 + 0.45 * rand())
            printf " %.1f,%.1f", cx + rr * cos(a), cy + rr * sin(a) * (0.7 + 0.3 * rand())
          }
          print ""
        } }' > "$TMP/chips.mvg"
      magick -size ${w}x${h} xc:"#EFEAE2" -draw @"$TMP/chips.mvg" "$out" ;;
    linen)
      # Horizontal and vertical threads (noise smeared both ways) on warm beige. The weave is uniform, so a
      # seamless 1024px tile (wrap-around blur) is built at half scale and repeated across the frame.
      local len=$(( s / 600 + 2 ))
      mg -size 512x512 xc:gray50 -attenuate 1 +noise Gaussian -colorspace gray -virtual-pixel tile \
        \( +clone -motion-blur 0x${len}+0 \) \( -clone 0 -motion-blur 0x${len}+90 \) -delete 0 \
        -compose multiply -composite -auto-level +level 40%,60% -resize 1024x1024 "$TMP/weave.miff"
      magick -size ${w}x${h} tile:"$TMP/weave.miff" \( -size ${w}x${h} xc:"#E7DFD2" \) +swap \
        -compose hardlight -composite "$out" ;;
  esac
}

pastel() {  # name -> hex for the Instax-style presets; anything else passes through
  case "$1" in
    cream) echo "#F3EFE6" ;; pink) echo "#F5C8D2" ;; mint)  echo "#BFE3D0" ;;
    sky)   echo "#BCD8EE" ;; lemon) echo "#F6E7A6" ;; lilac) echo "#D8CCEA" ;;
    black) echo "#111111" ;;
    # Instax-style diagonal gradients (top-left -> bottom-right)
    sunset) echo "#FBD3C4-#F3B6D0" ;; ocean) echo "#BFE6F2-#C9C3F0" ;; aurora) echo "#C7F0DA-#BCD0F5" ;;
    peach)  echo "#FFE9B8-#F8BBA6" ;; dusk)  echo "#2B3A67-#6B4E8C" ;;
    *) echo "$1" ;;
  esac
}

ME=$(basename "$0")
VERSION="1.2.2"
help() {
  cat <<HELP
$ME — frame photos with a border, title, camera info and maker logo

Usage: $ME [-b border] [-p strength] [-s size] [-m metadata] photo.jpg …
       $ME -L
       $ME -h | -V

Writes <photo>_<border>_<size>.jpg next to each photo (IMG_0042_marble_4k.jpg;
colours are written without # or brackets: IMG_0042_2B4C7E_grow.jpg). The title comes from the photo's
Title tag, else its City, else the file name; the line below shows city and date.

  -b border    Border style (default: white)
                 Solid:      white, black, cream, pink, mint, sky, lemon, lilac,
                             or any colour: '#2B4C7E', navy, 'rgb(40,60,90)'
                 Auto:       auto       a light pastel picked from the photo
                 Gradient:   sunset, ocean, aurora, peach, dusk,
                             or two colours: '#FFD6E0-#B5E2FA'
                 Glass:      frost, frost-dark   the photo blurred behind frosted glass
                 Stone:      marble, marble-dark, marble-green, marble-beige, terrazzo
                             (photo and lettering inset into the stone)
                 Fabric:     linen
                 Print:      poster, poster-colour   Swiss-style poster: photo, huge title in
                             Helvetica Neue, and a grid of place/date, camera, exposure; on
                             off-white paper, or on the photo's main colour
                             cover-yellow   magazine-cover look: a yellow rectangle inset on
                             the full-bleed photo (same size as the original, no text)
                             cover-red      magazine-cover look: red border with a thin white
                             inner line around the photo (no text)
                             postcard   white-bordered travel postcard: the city (else the
                             country) in big retro capitals across the top (Futura Condensed)
                 Gallery:    museum, museum-white, museum-black   wide mat (warm off-white,
                             white or black) with a bevelled opening and a museum wall label:
                             title, place and year, medium (film simulation), camera, exposure
                 Film:       contact    black contact-sheet frame printed in amber, with film-edge
                             markings along the top instead of a logo: maker, film simulation
                             and ISO (FUJIFILM PROVIA ISO 200, SONY ISO 200), and frame
                             numbers from the file name (…_33.jpg -> 33, 33A, 34)
  -p strength  Paper texture on solid and gradient borders: 0 (off) to 30, default 6
  -s size      Output size (default: grow)
                 grow        full-resolution photo; the frame adds to the outer size
                 fit         keep the original's long edge; the short edge follows
                 4k, 2k, fhd long side 3840, 2560 or 1920 px
                 <number>    long side in px
               (4k, 2k, fhd and <number> only ever shrink)
  -m metadata  keep  (default) copy the photo's metadata (camera, GPS, title …) to the result
               strip remove it all; only the colour profile is kept. The frame still shows
                     what's printed on it.
  -L           Download all known manufacturer logos now (only missing ones), then exit
  -h           Show this help
  -V           Show the version

Examples:
  $ME holiday/*.jpg
  $ME -b marble -s 4k IMG_0042.jpg
  $ME -b '#F5C8D2-#BCD8EE' -p 0 photo.jpg

Manufacturer logos:
  Folder     $LOGO_DIR   (set BORDERMAGICK_HOME to move it)
  Download   Logos of these makers are fetched from Wikimedia Commons the first time a
             photo needs one (or all at once with -L) and kept, so later runs work offline:
$(for k in $LOGO_KEYS; do brand_name $k; done | paste -sd, - | sed 's/,/, /g' |
  fold -s -w 64 | sed 's/ *$//; s/^/               /')
             Some are adjusted on download: Nikon is cut to its yellow "Nikon" band,
             OM System's white letters become see-through.
  Refresh    Delete a logo from the folder; it is downloaded again next time.
  Your own   A PNG you put in the folder always wins (also for other makers).
             Name: first word of the photo's EXIF Make, lower case, + .png
               FUJIFILM -> fujifilm.png   NIKON CORPORATION -> nikon.png
               SIGMA    -> sigma.png      LEICA CAMERA AG   -> leica.png
             Exceptions: EASTMAN KODAK -> kodak.png
                         PENTAX models made by RICOH -> pentax.png
                         Apple iPhone -> iphone.png, Apple iPad -> ipad.png,
                         other Apple devices -> apple.png
             Check a photo's Make and Model with:  exiftool -Make -Model photo.jpg
  Format     PNG with a transparent background; black or dark lettering, coloured
             accents allowed (on dark borders the dark parts turn white, colours stay;
             Nikon's logo has its own yellow background and is never changed).
             Any size: empty space around the logo is trimmed and it is scaled to fit,
             so a large, sharp file (1000+ px wide) works best.
  Sizing     Wide wordmarks match the text height; squarer logos and badges are drawn
             up to 1.6x taller so they look equally big.
  Missing    no logo file and no download -> the camera info is shown without a logo.
HELP
}
LOGO_KEYS="apple ipad iphone canon fujifilm google hasselblad kodak leica nikon olympus om panasonic
           pentax polaroid ricoh samsung sony xiaomi"

brand_name() {  # logo key -> name as shown in the help
  case "$1" in
    ipad) echo "Apple iPad" ;; iphone) echo "Apple iPhone" ;; om) echo "OM System" ;;
    *) echo "$(tr '[:lower:]' '[:upper:]' <<<"${1:0:1}")${1:1}" ;;
  esac
}

# Wikimedia Commons file for each maker key (checked by hand: Commons search often finds the wrong company)
commons_file() {
  case "$1" in
    apple) echo "Apple logo black.svg" ;;        canon) echo "Canon logo.svg" ;;
    iphone) echo "Apple iPhone.svg" ;;           ipad) echo "IPad Logo With Logo Apple.svg" ;;
    fujifilm) echo "Fujifilm logo.svg" ;;        google) echo "Google 2015 logo.svg" ;;
    hasselblad) echo "Hasselblad logo.svg" ;;    kodak) echo "Kodak logo.svg" ;;
    leica) echo "Leica Camera.svg" ;;            nikon) echo "Nikon Logo.svg" ;;
    olympus) echo "Olympus Corporation logo.svg" ;; om) echo "OMDS OM-System-Logo.svg" ;;
    panasonic) echo "Panasonic logo (Blue).svg" ;; pentax) echo "Pentax Logo.svg" ;;
    polaroid) echo "Polaroid logo.svg" ;;        ricoh) echo "Ricoh logo 2005.svg" ;;
    samsung) echo "Samsung wordmark.svg" ;;      sony) echo "Sony logo.svg" ;;
    xiaomi) echo "Xiaomi logo horizontal (2021-).svg" ;;
    *) return 1 ;;
  esac
}

# Make sure $LOGO_DIR/<key>.png exists, downloading it from Commons on first use.
# Each maker is tried at most once per run; failures are reported but never stop the framing.
TRIED=" "
fetch_logo() {
  local key=$1 file url
  [[ -f "$LOGO_DIR/$key.png" || "$TRIED" == *" $key "* ]] && return 0
  TRIED="$TRIED$key "
  if ! file=$(commons_file "$key"); then
    echo "$ME: no logo for '$key' (add your own as $LOGO_DIR/$key.png)" >&2; return 0
  fi
  mkdir -p "$LOGO_DIR"
  # Special:FilePath renders the SVG as a transparent PNG at the requested width
  url="https://commons.wikimedia.org/wiki/Special:FilePath/${file// /_}?width=2000"
  if curl -sfL --max-time 30 -A "bordermagick/1.0 (photo framing script)" -o "$TMP/dl.png" "$url" &&
     [[ "$(magick identify -format %m "$TMP/dl.png" 2>/dev/null)" == PNG ]]; then
    # Per-logo touch-ups
    case "$key" in
      nikon) magick "$TMP/dl.png" -trim +repage -gravity south -crop 100%x32%+0+0 +repage "$TMP/dl.png" ;;  # just the "Nikon" band, without the rays above
      om)    magick "$TMP/dl.png" -fuzz 10% -transparent white "$TMP/dl.png" ;;  # opaque file: white letters become cut-outs
    esac
    mv "$TMP/dl.png" "$LOGO_DIR/$key.png"
    echo "$ME: downloaded $key logo from Wikimedia Commons ($file)" >&2
  else
    echo "$ME: couldn't download the $key logo (offline?)" >&2
  fi
}

die() {  # message [hint]
  echo "$ME: $1" >&2
  [[ -n "${2:-}" ]] && echo "$2" >&2
  echo "Run '$ME -h' for help." >&2
  exit 2
}

[[ "${1:-}" == --help ]] && { help; exit 0; }
[[ "${1:-}" == --version ]] && { echo "$ME $VERSION"; exit 0; }
# For writing layouts: the tags a photo has, and a layout as bordermagick reads it (with what it extends)
if [[ "${1:-}" == --tags ]]; then
  shift; (( $# )) || die "--tags needs a photo"
  idx=0
  for in in "$@"; do
    idx=$(( idx + 1 ))
    [[ -f "$in" ]] || die "no such file: $in"
    (( $# > 1 )) && echo "== $in"
    read_tags "$in" "$idx"; print_tags
  done
  exit 0
fi
if [[ "${1:-}" == --dump-layout ]]; then
  [[ -n "${2:-}" ]] || die "--dump-layout needs a layout name" "$(ly_available)"
  layout_load "$2"; layout_dump
  exit 0
fi
# --plan: print where a layout puts everything instead of writing the photos
PLAN=0
if [[ "${1:-}" == --plan ]]; then PLAN=1; shift; fi
DOWNLOAD_ALL=0
BORDER="white"; PAPER=6; SIZE="grow"; META="keep"
while getopts ":b:p:s:m:LhV" opt; do
  case "$opt" in
    b) BORDER="$OPTARG" ;;
    p) PAPER="$OPTARG" ;;
    s) SIZE="$OPTARG" ;;
    m) META="$OPTARG" ;;
    L) DOWNLOAD_ALL=1 ;;
    h) help; exit 0 ;;
    V) echo "$ME $VERSION"; exit 0 ;;
    :) die "option -$OPTARG needs a value" ;;
    *) die "unknown option -$OPTARG" ;;
  esac
done
shift $((OPTIND - 1))

# -L: fetch every known logo that isn't in the folder yet (a pause between requests keeps
# Wikimedia's rate limit happy), report what's there, and stop
if (( DOWNLOAD_ALL )); then
  have=0; got=0
  for key in $LOGO_KEYS; do
    if [[ -f "$LOGO_DIR/$key.png" ]]; then have=$(( have + 1 )); continue; fi
    (( got )) && sleep 1
    fetch_logo "$key"; got=$(( got + 1 ))
  done
  n=$(echo $LOGO_KEYS | wc -w | tr -d ' ')
  ok=0; for key in $LOGO_KEYS; do [[ -f "$LOGO_DIR/$key.png" ]] && ok=$(( ok + 1 )); done
  echo "$ME: $ok of $n logos in $LOGO_DIR ($have were already there)"
  (( ok == n )) && exit 0 || exit 1
fi

(( $# )) || { help; exit 0; }

case "$SIZE" in
  grow|fit) LONG="" ;;
  4k|4K)    LONG=3840 ;;
  2k|2K)    LONG=2560 ;;
  fhd|FHD)  LONG=1920 ;;
  *[!0-9]*|""|0) die "invalid size '$SIZE'" "Use grow, fit, 4k, 2k, fhd or a number of pixels." ;;
  *)        LONG="$SIZE" ;;
esac

[[ "$META" == keep || "$META" == strip ]] || die "invalid metadata option '$META'" "Use keep or strip."

[[ "$PAPER" =~ ^[0-9]+$ ]] && (( PAPER <= 30 )) ||
  die "invalid paper strength '$PAPER'" "Use a whole number from 0 (off) to 30."

# Border: a layout file, a named style, or one colour / two joined by "-" (with the standard layout if
# there is one)
LAYOUT=""
if layout_find "$BORDER" >/dev/null; then LAYOUT=$BORDER; fi
[[ -n "$LAYOUT" ]] || case "$BORDER" in
  auto|frost|frost-dark|marble|marble-dark|marble-green|marble-beige|terrazzo|linen|contact|museum|museum-white|museum-black|poster|poster-colour|postcard|cover-yellow|cover-red) ;;
  *)
    IFS=- read -r -a parts <<<"$(pastel "$BORDER")"
    (( ${#parts[@]} <= 2 )) ||
      die "invalid border '$BORDER'" "A gradient takes exactly two colours, e.g. '#FFD6E0-#B5E2FA'."
    for c in "${parts[@]}"; do
      # (an unknown colour name is only a warning to ImageMagick, so any output counts as failure)
      [[ -n "$c" && -z "$(magick xc:"$c" null: 2>&1)" ]] ||
        die "unknown border '$BORDER'" "'$c' is neither a style nor a colour ImageMagick knows. See the list under -b."
    done
    if layout_find standard >/dev/null; then LAYOUT=standard; fi ;;
esac
if [[ "$BORDER" == auto ]] && layout_find standard >/dev/null; then LAYOUT=standard; fi
if [[ -n "$LAYOUT" ]]; then
  LY_VAR_paper=$PAPER
  if [[ "$LAYOUT" == "$BORDER" ]]; then LY_VAR_border=white; else LY_VAR_border=$(pastel "$BORDER"); fi
  layout_load "$LAYOUT"
elif (( PLAN )); then
  die "--plan works with layout files" "$(ly_available)"
fi

# =====================================================================================================
# Framing pipeline. One photo goes through these stages in order (frame_photo); each stage reads and
# sets plain global variables. A border style is a set of switches (style_setup), so a new style is
# one case there plus the stage that draws it.
# =====================================================================================================

u() { echo $(( S * $1 / 1000 )); }   # tenths of a percent of the photo's short side

# --- Style switches, from -b (the same for every photo in a run)
#   KIND     background: solid | gradient | frost | material | film
#   INSET    photo and lettering cut into the surface (stone)
#   LOGO_ON  maker logo above the camera info
#   FILM     contact-sheet layout: edge print, one condensed uppercase size, no logo
#   MUSEUM   mat-board layout: wide bottom-weighted mat, bevelled opening, wall label instead of the strip
#   POSTER   poster layout: photo, huge title, rule and a three-column grid below
#   POSTCARD postcard front: even white border, caption written on the photo
#   COVER    magazine-cover frame without text: yellow (inset rectangle) or red (border)
style_setup() {
  KIND=solid; INSET=0; LOGO_ON=1; FILM=0; MUSEUM=0; POSTER=0; POSTCARD=0; COVER=""
  case "$BORDER" in
    frost|frost-dark) KIND=frost ;;
    marble|marble-dark|marble-green|marble-beige|terrazzo) KIND=material; INSET=1 ;;
    linen) KIND=material ;;
    contact) KIND=film; LOGO_ON=0; FILM=1 ;;
    museum|museum-white|museum-black) KIND=museum; LOGO_ON=0; MUSEUM=1
      # mat, bevel core, label ink (title), label ink (details)
      case "$BORDER" in
        museum)       MAT="#F3F0E8"; CORE="#FBFAF6"; INK="#2A2826"; INK2="#6E6A64" ;;
        museum-white) MAT="#FAFAF8"; CORE="#FFFFFF"; INK="#2A2826"; INK2="#6E6A64" ;;
        museum-black) MAT="#161616"; CORE="#ECEAE4"; INK="#E8E6E1"; INK2="#A39F98" ;;
      esac ;;
    poster|poster-colour) KIND=poster; LOGO_ON=0; POSTER=1 ;;
    postcard) KIND=card; LOGO_ON=0; POSTCARD=1 ;;
    cover-yellow) KIND=cover; LOGO_ON=0; COVER=yellow ;;
    cover-red)    KIND=cover; LOGO_ON=0; COVER=red ;;
    auto) ;;
    *) if [[ "$(pastel "$BORDER")" == *-* ]]; then KIND=gradient; fi ;;   # "colour1-colour2"
  esac
  # Paper texture (strength PAPER_K) on the plain surfaces
  PAPER_ON=0; PAPER_K=$PAPER
  case "$KIND" in solid|gradient|museum|poster|card) (( PAPER > 0 )) && PAPER_ON=1 ;; esac
  if [[ "$BORDER" == museum-black ]]; then PAPER_K=$(( PAPER / 3 )); fi   # black mat board is smooth; the relief shows strongly on black
}

# --- 1. Metadata: text lines and maker logo
read_meta() {
  read_tags "$in" "$idx"
  make=$T_make; model=$T_model; lens=$T_lens; key=$T_key; city=$T_city; date=$T_date
  # Settings line from whatever the photo has ("35.8 mm ∙ ƒ/11.0 ∙ 1/340s ∙ ISO 200"); missing values are
  # left out. The contact sheet prints the ISO in the film edge instead.
  if (( FILM )); then info=$(join_sep "$T_focal" "$T_aperture" "$T_shutter"); else info=$T_exposure; fi
  # Kept separately for layouts that split the settings over two lines (poster)
  EXP1=$(join_sep "$T_focal" "$T_aperture"); EXP2=$(join_sep "$T_shutter" "$T_iso")
  camera="$model${lens:+ $SEP $lens}"

  # Title: Title tag, else City, else the file name. The line below shows city and date,
  # minus the city when it's already the title.
  title=${T_title:-${T_city:-$T_filename}}
  place=$T_place
  sub="$place${place:+${date:+ $SEP }}$date"

  logo=""
  if (( LOGO_ON )); then
    logo="$LOGO_DIR/$key.png"
    if [[ -n "$key" ]]; then fetch_logo "$key"; fi
  fi
  return 0
}

# Poster: everything is measured from the sheet width (photo width + margins), and the text is rendered
# first because its height sets the sheet height. Paper and ink: off-white with black, or the photo's most
# common colour (deepened so type stays bold on it) with black or white, whichever reads better.
poster_layout() {
  local m=$(( W * 6 / 100 )) sw pt cw1 cw2 cw3 gap rule ch
  sw=$(( W + 2 * m ))
  pu() { echo $(( sw * $1 / 1000 )); }
  if [[ "$BORDER" == poster ]]; then
    PBG="#F6F5F1"; PINK="#111111"
  else
    PBG=$(magick "$in" -resize 200x200 -kmeans 5 -format %c histogram:info: | sort -rn | head -1 | grep -oE '#[0-9A-Fa-f]{6}')
    PBG=$(magick xc:"$PBG" -modulate 80,130 -format "#%[hex:u.p{0,0}]" info:)
    if (( $(magick xc:"$PBG" -format "%[fx:luminance<0.45]" info:) )); then PINK="#FFFFFF"; else PINK="#111111"; fi
  fi
  # Title: huge, left aligned, wrapping to the sheet width, tight leading. (The tight leading also shortens
  # the last line and would clip descenders and underscores, so a blank line is added and trimmed away.)
  pt=$(pu 110)
  magick -background none -fill "$PINK" -font HelveticaNeue-Bold -pointsize $pt -kerning $(( -pt / 40 )) \
    -interline-spacing $(( -pt * 18 / 100 )) -size $(( sw - 2 * m ))x caption:"$(im_text "$title")"$'\n'" " -trim +repage "$TMP/ptitle.miff"
  # Grid: place and date | camera and lens (widest) | exposure; long lines wrap within their column
  PPS=$(pu 22); cw1=$(( (sw - 2 * m) * 28 / 100 )); cw2=$(( (sw - 2 * m) * 44 / 100 )); cw3=$(( sw - 2 * m - cw1 - cw2 ))
  pcol() {  # width text out (an empty column becomes a blank 1-pixel image)
    if [[ -z "$2" ]]; then magick -size 1x1 xc:none "$3"; return; fi
    magick -background none -fill "$PINK" -font HelveticaNeue-Medium -pointsize $PPS \
      -interline-spacing $(( PPS / 4 )) -size $(( $1 - PPS ))x caption:"$(im_text "$2")" "$3"
  }
  pcol $cw1 "$(printf '%s\n%s' "$place" "$date" | sed '/^$/d')" "$TMP/pc1.miff"
  pcol $cw2 "$(printf '%s\n%s' "$T_body" "$lens" | sed '/^$/d')" "$TMP/pc2.miff"
  pcol $cw3 "$(printf '%s\n%s' "$EXP1" "$EXP2" | sed '/^$/d')" "$TMP/pc3.miff"
  PCX=( $m $(( m + cw1 )) $(( m + cw1 + cw2 )) )
  gap=$(pu 45); rule=$(( sw / 600 + 2 ))
  ch=$(magick "$TMP/pc1.miff" "$TMP/pc2.miff" "$TMP/pc3.miff" -format "%h\n" info: | sort -n | tail -1)
  PY_TITLE=$gap
  PY_RULE=$(( gap + $(magick "$TMP/ptitle.miff" -format %h info:) + gap ))
  PY_COLS=$(( PY_RULE + rule + gap / 2 ))
  PRULE=$rule
  # Sheet: margin m on the sides and top; below the photo the title, rule, grid and a bottom margin
  B=$m; TOPB=$m; BOT=$(( PY_COLS + ch + m ))
}

# --- 2. Layout: everything sized from the photo's short side (after EXIF rotation)
layout() {
  read -r W H < <(magick "$in" -auto-orient -format "%w %h\n" info:)
  S=$(( W < H ? W : H ))
  B=$(u 30)                     # side border; also the top border, except on the contact sheet
  BOT=$(u 130)                  # bottom strip height
  PT=$(u 40)                    # title font size
  PS=$(u 17)                    # all other text
  LOGO_H=$(u 18)                # visible height of a wide wordmark (padding trimmed); squarer logos get more
  # Baselines, measured up from the bottom edge. The title's top lines up with the logo's top,
  # the place/date line shares a baseline with the settings line.
  Y_TITLE=$(u 66); Y_CAM=$(u 62); Y_LOGO=$(u 88); Y_LOW=$(u 36)
  TOPB=$B
  if (( FILM )); then
    # Contact sheet: a taller top border for the edge print, and one text size throughout so both sides
    # mirror each other (bright line over dim line), with equal margins above and below the two lines
    TOPB=$(( 2 * B ))
    PS=$(u 22); PT=$PS; BOT=$(u 110); Y_TITLE=$(u 64); Y_CAM=$(u 64); Y_LOW=$(u 30)
  fi
  if (( MUSEUM )); then
    # Mat board: wide, and taller at the bottom so the photo doesn't look like it's sliding down
    B=$(u 140); TOPB=$B; BOT=$(u 260)
  fi
  if (( POSTCARD )); then B=$(u 45); TOPB=$B; BOT=$B; fi
  # Covers: yellow is drawn on the photo itself (no border); red is a red frame plus a thin white line
  if [[ "$COVER" == yellow ]]; then B=0; TOPB=0; BOT=0; fi
  if [[ "$COVER" == red ]]; then B=$(( $(u 55) + $(u 10) )); TOPB=$B; BOT=$B; fi
  if (( POSTER )); then poster_layout; fi
  FW=$(( W + 2*B )); FH=$(( H + TOPB + BOT ))

  # Optical sizing: a square badge at a wordmark's height looks tiny, so logos narrower than ~5:1 grow
  # with the square root of how much squarer they are, up to 1.6x (what fits above the camera line)
  LH=$(logo_height "$LOGO_H")
  return 0
}

logo_height() {  # height of a wide wordmark -> height for this logo
  if [[ -f "$logo" ]]; then
    magick "$logo" -trim -format "%[fx:w/h]" info: |
      awk -v h=$1 '{ f = sqrt(5 / $1); if (f < 1) f = 1; if (f > 1.6) f = 1.6; printf "%d", h * f }'
  else
    echo "$1"
  fi
}

# Text from metadata and file names as ImageMagick text: label:, caption: and -annotate read a leading @
# as a file name, and turn backslash and percent escapes into other text. Double every backslash and %,
# and escape a leading @, so the text prints as it is.
im_text() { local t=${1//\\/\\\\}; t=${t//%/%%}; [[ "$t" == @* ]] && t="\\$t"; printf '%s' "$t"; }

# Text width at a given size (terrazzo's keep-clear boxes), and the largest of several numbers
text_w() { magick -font "$FONT" -pointsize "$1" label:"$(im_text "$2")" -format "%w" info:; }
max() { printf "%s\n" "$@" | sort -n | tail -1; }

# The photo's average colour, lifted to a light pastel
auto_colour() {
  magick "$in" -resize 1x1\! -colorspace HSL -channel G -evaluate multiply 1.4 \
    -channel B -evaluate set 82% +channel -colorspace sRGB -format "#%[hex:u.p{0,0}]" info:
}

# --- 3. Background: the full-size canvas the photo is placed on (lets gradients span the whole frame)
background() {
  # Border colour; "auto" = the photo's average colour, lifted to a light pastel
  if [[ "$BORDER" == auto ]]; then
    BG=$(auto_colour)
  else
    BG=$(pastel "$BORDER")
  fi
  shadow=()
  case "$KIND" in
    frost)
      # Frosted glass: the photo stretched to fill the frame, blurred (cheaply, at 1/16 size), washed with a
      # tint so text stays readable, plus fine grain for the frosted texture
      local tint sw sh sp
      if [[ "$BG" == frost ]]; then tint=( -fill white -colorize 55% ); else tint=( -fill black -colorize 50% ); fi
      sw=$(( FW / 16 )); sh=$(( FH / 16 ))
      canvas=( \( "$in" -auto-orient -resize ${sw}x${sh}^ -gravity center -extent ${sw}x${sh} -blur 0x4
                   -resize ${FW}x${FH}\! "${tint[@]}" -attenuate 0.2 +noise Gaussian \) )
      # Soft drop shadow under the photo so it floats above the glass (also built small and scaled up)
      sp=$(( B / 32 + 1 ))
      shadow=( \( -size $(( W / 16 ))x$(( H / 16 )) "xc:rgba(0,0,0,0.35)" -bordercolor none -border $(( 2*sp ))
                   -blur 0x$sp -resize $(( W + 64*sp ))x$(( H + 64*sp ))\! \)
               -gravity northwest -geometry $(printf "%+d%+d" $(( B - 32*sp )) $(( B - 32*sp + B/6 ))) -composite ) ;;
    material)
      if [[ "$BG" == terrazzo ]]; then
        # Keep chips off the text: measure both text blocks (plus the logo) and pass them as keep-clear boxes
        local lw rw logo_w=0 pad top bot
        lw=$(max "$(text_w $PT "$title")" "$( [[ -n "$sub" ]] && text_w $PS "$sub" || echo 0 )")
        if [[ -f "$logo" ]]; then logo_w=$(magick "$logo" -trim -format "%[fx:round(w*$LH/h)]" info:); fi
        rw=$(max "$(text_w $PS "$camera")" "$(text_w $PS "$info")" "$logo_w")
        pad=$(( PS / 2 )); top=$(( FH - Y_LOGO - LH - pad )); bot=$(( FH - Y_LOW + PS / 2 ))
        CLEAR="$(( B - pad )),$top,$(( B + lw + pad )),$bot $(( FW - B - rw - pad )),$top,$(( FW - B + pad )),$bot"
      fi
      material "$BG" $FW $FH "$TMP/material.miff"
      canvas=( "$TMP/material.miff" ) ;;
    film)     canvas=( "xc:#111111" ) ;;
    museum)   canvas=( "xc:$MAT" ) ;;
    poster)   canvas=( "xc:$PBG" ) ;;
    card)     canvas=( "xc:#FBF9F3" ) ;;
    cover)    canvas=( "xc:#E3120B" ) ;;
    gradient) canvas=( -define gradient:angle=135 "gradient:$BG" ) ;;   # diagonal, top-left -> bottom-right
    *)        canvas=( "xc:$BG" ) ;;
  esac
  return 0
}

# --- 4. Ink: text and logo colours follow the border's average brightness; secondary text is
# translucent so it picks up the tint. The contact sheet prints everything in amber.
ink() {
  local lum
  case "$KIND" in
    frost)    if [[ "$BG" == frost ]]; then lum=0.9; else lum=0.1; fi ;;   # the tint dominates; skip rendering the canvas
    material) lum=$(magick "$TMP/material.miff" -resize 1x1\! -format "%[fx:luminance]" info:) ;;
    *)        lum=$(magick -size 64x64 "${canvas[@]}" -resize 1x1\! -format "%[fx:luminance]" info:) ;;
  esac
  canvas_ink "$lum"
  if (( FILM )); then FG="$AMBER"; FG2="rgba(242,177,52,0.6)"; fi
  if (( MUSEUM )); then FG="$INK"; FG2="$INK2"; fi
  if (( POSTER )); then FG="$PINK"; FG2="$PINK"; fi
  return 0
}

# Ink for a background of this luminance (0–1): dark or light text (FG), and a translucent secondary (FG2)
canvas_ink() {
  LUM=$1
  if (( $(awk -v l="$1" 'BEGIN { print (l < 0.5) }') )); then
    DARK=1; FG="#EEEEEE"; FG2="rgba(255,255,255,0.6)"
  else
    DARK=0; FG="#222222"; FG2="rgba(0,0,0,0.5)"
  fi
}

# --- 5. Paper texture for solid/gradient borders: directional fibres + faint large-scale mottling,
# embossed into a grey relief map and hard-light blended (so it shows on pure white as well as on dark
# colours). Built at half size and scaled up: ~3x faster, and the grain is soft enough that it doesn't show.
paper() {
  if (( PAPER_ON )); then
    local hw=$(( FW / 2 )) hh=$(( FH / 2 )) k=$PAPER_K
    canvas+=( \( -size ${hw}x${hh} xc:gray50 -attenuate 1 +noise Gaussian -colorspace gray
                  -motion-blur 0x$(awk -v s=$S 'BEGIN { printf "%.1f", s / 3000 }')+30
                  \( -size $(( FW / 40 ))x$(( FH / 40 )) xc:gray50 -attenuate 1 +noise Gaussian -colorspace gray
                     -blur 0x1.5 -resize ${hw}x${hh}\! \) -compose overlay -composite
                  -shade 120x55 -auto-level +level $(( 50 - k ))%,$(( 50 + k ))% -resize ${FW}x${FH}\! \)
              -compose hardlight -composite -compose over )
  fi
  return 0
}

# --- 6. Photo on the canvas; on stone it's recessed: an inner shadow over its top and left edges (built
# at 1/8 size and scaled up), a shadow line on the stone's cut edge above/left, and a highlight where
# light catches it below/right
place_photo() {
  args=( -size ${FW}x${FH} "${canvas[@]}" ${shadow[@]+"${shadow[@]}"} )
  if (( MUSEUM )); then
    # Bevelled mat opening: a bright core edge around the photo, with a soft shadow on its top and left
    # where the light falls into the cut
    local bev=$(( S / 250 + 2 ))
    args+=( -fill "$CORE" -draw "rectangle $(( B - bev )),$(( TOPB - bev )) $(( B + W + bev - 1 )),$(( TOPB + H + bev - 1 ))"
            \( -size $(( W + 2 * bev ))x$(( H + 2 * bev )) xc:none -fill "rgba(0,0,0,0.10)"
               -draw "rectangle 0,0 $(( W + 2 * bev - 1 )),$(( bev / 2 ))" -draw "rectangle 0,0 $(( bev / 2 )),$(( H + 2 * bev - 1 ))"
               -blur 0x1 \) -gravity northwest -geometry +$(( B - bev ))+$(( TOPB - bev )) -composite )
  fi
  args+=( \( "$in" -auto-orient \) -gravity northwest -geometry +$B+$TOPB -composite )
  if (( INSET )); then
    local sc=8 sw sh d sg lw
    sw=$(( W / sc )); sh=$(( H / sc )); d=$(( B / 6 / sc + 1 )); sg=$(( B / 5 / sc + 1 )); lw=$(( B / 40 + 1 ))
    args+=( \( -size ${W}x${H} xc:black
               \( -size ${sw}x${sh} xc:white -fill black -draw "rectangle $d,$d $(( sw + 3*sg )),$(( sh + 3*sg ))"
                  -blur 0x$sg -resize ${W}x${H}\! -evaluate multiply 0.6 \)
               -alpha off -compose CopyOpacity -composite \)
            -compose over -gravity northwest -geometry +$B+$B -composite
            -fill "rgba(0,0,0,0.35)"
            -draw "rectangle $(( B - lw )),$(( B - lw )) $(( B + W - 1 )),$(( B - 1 ))"
            -draw "rectangle $(( B - lw )),$(( B - lw )) $(( B - 1 )),$(( B + H - 1 ))"
            -fill "rgba(255,255,255,0.5)"
            -draw "rectangle $B,$(( B + H )) $(( B + W + lw - 1 )),$(( B + H + lw - 1 ))"
            -draw "rectangle $(( B + W )),$B $(( B + W + lw - 1 )),$(( B + H + lw - 1 ))" )
  fi
  return 0
}

# --- 7. Text: title and place/date on the left, camera and settings on the right.
# Engraved on stone: a shadow copy nudged up-left and a highlight copy nudged down-right go first.
text_layer() {  # dx dy (screen px, right/down) primary-fill secondary-fill
  local dx=$1 dy=$2
  args+=( -gravity southwest -pointsize "$PT" -fill "$3" -annotate +$(( B + dx ))+$(( Y_TITLE - dy )) "$(im_text "$title")"
                             -pointsize "$PS" -fill "$4" -annotate +$(( B + dx ))+$(( Y_LOW - dy ))   "$(im_text "$sub")"
          -gravity southeast -pointsize "$PS" -fill "$3" -annotate +$(( B - dx ))+$(( Y_CAM - dy ))   "$(im_text "$camera")"
                             -pointsize "$PS" -fill "$4" -annotate +$(( B - dx ))+$(( Y_LOW - dy ))   "$(im_text "$info")" )
}
upper() { perl -CS -Mutf8 -pe '$_ = uc; s/Ƒ/ƒ/g' <<<"$1"; }   # (ƒ stays lowercase: DIN Condensed has no Ƒ)

add_text() {
  local tfont="$FONT"
  o=$(( PS / 22 + 1 ))          # engraving offset (also used for the logo)
  if (( FILM )); then
    # Film-edge look: everything in uppercase DIN Condensed, like the edge print
    tfont="$FONT_COND"
    title=$(upper "$title"); sub=$(upper "$sub"); camera=$(upper "$camera"); info=$(upper "$info")
  fi
  args+=( -font "$tfont" )
  if (( INSET )); then
    text_layer -$o -$o "rgba(0,0,0,0.45)" "rgba(0,0,0,0.3)"
    text_layer  $o  $o "rgba(255,255,255,0.55)" "rgba(255,255,255,0.35)"
  fi
  text_layer 0 0 "$FG" "$FG2"
  return 0
}

# --- 7b. Museum wall label below the photo's right edge, in Georgia like a gallery label:
#   Erechtheion                                   title
#   Athens, 2023                                  place and year (italic)
#   Digital photograph, Fujifilm Provia           medium: the film simulation, if any
#   Fujifilm X-T20 ∙ XF18-55mm F2.8-4 R LM OIS    camera and lens
#   35.8 mm ∙ ƒ/11.0 ∙ 1/340s ∙ ISO 200           exposure
add_label() {
  local year brand=$T_brand body=$T_body medium where p1 p2 lines=() lw
  year=$(tag_date %Y)
  where="$place${place:+${year:+, }}$year"
  medium="Digital photograph${T_film:+, $brand $T_film}"
  p1=$(u 26); p2=$(u 20)
  lines+=( \( -font "$SERIF Bold.ttf" -pointsize $p1 -fill "$FG" label:"$(im_text "$title")" \) )
  [[ -n "$where" ]] && lines+=( \( -size 1x$(( p2 / 3 )) xc:none +size \)
                                \( -font "$SERIF Italic.ttf" -pointsize $p2 -fill "$FG" label:"$(im_text "$where")" \) )
  lines+=( \( -size 1x$(( p2 * 3 / 4 )) xc:none +size \)
           \( -font "$SERIF.ttf" -pointsize $p2 -fill "$FG2" label:"$(im_text "$medium")" \) )
  [[ -n "$body$lens" ]] && lines+=( \( -font "$SERIF.ttf" -pointsize $p2 -fill "$FG2" label:"$(im_text "$body${body:+${lens:+ $SEP }}$lens")" \) )
  [[ -n "$info" ]] && lines+=( \( -font "$SERIF.ttf" -pointsize $p2 -fill "$FG2" label:"$(im_text "$info")" \) )
  magick -background none "${lines[@]}" -gravity west -append "$TMP/label.miff"
  lw=$(magick "$TMP/label.miff" -format %w info:)
  # A left-aligned block whose right edge lines up with the photo's right edge
  args+=( "$TMP/label.miff" -gravity northwest -geometry +$(( B + W - lw ))+$(( TOPB + H + $(u 55) )) -composite )
}

# --- 7c. Poster text: frame number top right, the title, a rule and the grid under the photo
add_poster() {
  local y0=$(( TOPB + H )) i
  args+=( -fill "$FG" -font HelveticaNeue-Medium -pointsize $PPS -gravity northeast
          -annotate +$B+$(( B / 2 - PPS / 2 )) "$(im_text "No. $T_frame")"
          -gravity northwest "$TMP/ptitle.miff" -geometry +$B+$(( y0 + PY_TITLE )) -composite
          -draw "rectangle $B,$(( y0 + PY_RULE )) $(( FW - B - 1 )),$(( y0 + PY_RULE + PRULE - 1 ))" )
  for i in 1 2 3; do
    args+=( "$TMP/pc$i.miff" -geometry +${PCX[$(( i - 1 ))]}+$(( y0 + PY_COLS )) -composite )
  done
}

# --- 7d. Postcard: the location in big retro condensed capitals, centred at the top of the photo over a
# soft shadow, like a classic travel postcard. The city, else the country, else no text. A long name
# shrinks to fit the photo width.
add_caption() {
  local name lbl pc k d top maxw w
  name=${T_city:-$T_country}
  [[ -n "$name" ]] || return 0
  name=$(upper "$name"); lbl=$(im_text "$name")
  pc=$(u 170); maxw=$(( W * 88 / 100 ))
  w=$(magick -font Futura-CondExtraBold -kerning $(( pc / 20 )) -pointsize $pc label:"$lbl" -format %w info:)
  if (( w > maxw )); then pc=$(( pc * maxw / w )); fi
  k=$(( pc / 20 )); d=$(( pc / 25 + 1 )); top=$(( TOPB + pc / 3 ))
  args+=( \( +size -background none -font Futura-CondExtraBold -kerning $k -pointsize $pc -fill "rgba(0,0,0,0.6)"
             label:"$lbl" -bordercolor none -border $(( pc / 4 )) -blur 0x$(( pc / 9 )) \)
          -gravity north -geometry +$d+$(( top - pc / 4 + d )) -composite
          \( +size -background none -font Futura-CondExtraBold -kerning $k -pointsize $pc -fill "#FFFDF6" label:"$lbl" \)
          -gravity north -geometry +0+$top -composite )
}

# --- 7e. Cover frames (no text). Yellow: a thick rectangle inset from the photo's edges, the photo
# showing on both sides of it. Red: the red canvas is the frame; a thin white line runs around the photo.
add_cover() {
  local t i w
  if [[ "$COVER" == yellow ]]; then
    i=$(u 45); t=$(u 38)
    args+=( -fill none -stroke "#FFCC00" -strokewidth $t
            -draw "rectangle $(( i + t / 2 )),$(( i + t / 2 )) $(( W - i - t / 2 - 1 )),$(( H - i - t / 2 - 1 ))"
            -stroke none )
  else
    w=$(u 10)
    args+=( -fill white -draw "rectangle $(( B - w )),$(( TOPB - w )) $(( B + W + w - 1 )),$(( TOPB + H + w - 1 ))"
            \( "$in" -auto-orient \) -gravity northwest -geometry +$B+$TOPB -composite )
  fi
}

# --- 8. Logo, on top of the camera info.
# On dark borders the logo's black parts turn white but coloured accents stay (Fuji's red I): each pixel
# is treated as a mix of accent colour and black (estimated from its chroma) and only the black share is
# lifted to white, so antialiased edges blend smoothly instead of leaving dark specks. Logos that bring
# their own background (Nikon's yellow band) are left as they are.
add_logo() {
  [[ -f "$logo" ]] || return 0
  prepare_logo "$LH" "$TMP/logo.miff"
  if (( INSET )); then   # engraved like the text: tinted silhouettes nudged up-left and down-right
    args+=( \( "$TMP/logo.miff" -fill black -colorize 100 -channel A -evaluate multiply 0.45 +channel \)
            -gravity southeast -geometry +$(( B + o ))+$(( Y_LOGO + o )) -composite
            \( "$TMP/logo.miff" -fill white -colorize 100 -channel A -evaluate multiply 0.55 +channel \)
            -gravity southeast -geometry +$(( B - o ))+$(( Y_LOGO - o )) -composite )
  fi
  args+=( "$TMP/logo.miff" -gravity southeast -geometry +$B+$Y_LOGO -composite )
}

prepare_logo() {  # height out: the logo trimmed, recoloured for the background and scaled
  local recolour=()
  if (( DARK )) && [[ "$key" != nikon ]]; then
    recolour=( -channel RGB
      -fx "chroma=max(max(u.r,u.g),u.b)-min(min(u.r,u.g),u.b); accent=min(1,chroma/0.75); min(1,u+1-accent)"
      +channel )
  fi
  if (( FILM )) && [[ "$key" != nikon ]]; then
    recolour+=( -channel R -evaluate multiply 0.949 -channel G -evaluate multiply 0.694
                -channel B -evaluate multiply 0.204 +channel )   # x amber
  fi
  # Trim the PNG's transparent padding so the logo is placed by its visible letters. Fully transparent
  # pixels can hide stray RGB (green-grey in fujifilm.png) that resizing bleeds into the edges — reset it
  # to black first. (-colorspace sRGB: some logos are greyscale PNGs, which have no channels to tint.)
  magick "$logo" -trim +repage -background black -alpha background -colorspace sRGB -resize x"$1" \
    ${recolour[@]+"${recolour[@]}"} "$2"
}

# --- 9. Contact sheet edge print along the top border: the film stock like on real film — maker, film
# simulation (if any), speed: "FUJIFILM PROVIA ISO 200", "SONY ISO 200" — then ▶ n, ▶ nA, ▶ n+1
add_edge_print() {
  (( FILM )) || return 0
  local maker iso film num n pe tri y base x t
  case "$key" in
    om) maker="OM SYSTEM" ;; iphone|ipad) maker="APPLE" ;;
    *) maker=$(tr '[:lower:]' '[:upper:]' <<<"$key") ;;
  esac
  iso=$X_ISO
  film=$(echo $maker $T_FILM ${iso:+ISO $iso})   # (echo joins the non-empty parts)
  n=$T_frame
  pe=$PS; tri=$(( pe * 60 / 100 ))                          # same size as the other text; triangle size
  y=$(( B * 85 / 100 )); base=$(( FH - y - pe * 50 / 100 ))  # y = centre of the row, from the top
  args+=( -fill "$AMBER" -stroke none -font "$FONT_COND" -pointsize $pe -gravity southwest
          -annotate +$B+$(( base - pe * 18 / 100 )) "$(im_text "$film")" )
  for t in "30:$n" "58:${n}A" "84:$(( n + 1 ))"; do
    x=$(( FW * ${t%%:*} / 100 ))
    args+=( -draw "polygon $x,$(( y - tri / 2 )) $(( x + tri )),$y $x,$(( y + tri / 2 ))"
            -annotate +$(( x + tri * 16 / 10 ))+$(( base - pe * 18 / 100 )) "$(im_text "${t#*:}")" )
  done
}

# --- 10. Render and write: optional final downscale (long side; fit = back to the original's long
# edge), done last so text and logo are rendered at full resolution; then the metadata
write_out() {
  local long="$LONG"
  if [[ "$SIZE" == fit ]]; then long=$(( W > H ? W : H )); fi
  if [[ -n "$long" ]]; then args+=( -resize "${long}x${long}>" ); fi

  mg "${args[@]}" -quality 95 "$out"

  if [[ "$META" == keep ]]; then
    # Copy metadata back, minus Orientation (pixels are already rotated) and the original's pixel dimensions
    exiftool -q -m -overwrite_original -TagsFromFile "$in" -all:all --Orientation \
      --ExifImageWidth --ExifImageHeight "$out"
  else
    # Strip everything, but keep the colour profile so colours still display correctly
    # (-q -q: no warning when there is no profile)
    exiftool -q -q -m -overwrite_original -all= -TagsFromFile "$in" -ICC_Profile "$out"
  fi
  echo "→ $out"
}

frame_photo() {
  read_meta; layout; background; ink; paper; place_photo
  if (( MUSEUM )); then add_label
  elif (( POSTER )); then add_poster
  elif (( POSTCARD )); then add_caption
  elif [[ -n "$COVER" ]]; then add_cover
  else add_text; fi
  add_logo; add_edge_print; write_out
}

# =====================================================================================================
# Main loop
# =====================================================================================================
style_setup
# Output name: <photo>_<border>_<size>.jpg, border made file-name safe ("#FFD6E0-#B5E2FA" -> FFD6E0-B5E2FA,
# "rgb(40,60,90)" -> rgb40-60-90)
tag=$(sed -E 's/[#()]//g; s/[^A-Za-z0-9.-]+/-/g; s/^-+|-+$//g' <<<"$BORDER")
status=0; idx=0
for in in "$@"; do
  idx=$(( idx + 1 ))
  if [[ ! -f "$in" ]]; then echo "$ME: no such file: $in (skipped)" >&2; status=1; continue; fi
  out="${in%.*}_${tag}_${SIZE}.jpg"
  if [[ -n "$LAYOUT" ]]; then
    (( PLAN && $# > 1 )) && echo "== $in"
    frame_layout
  else
    frame_photo
  fi
done
exit $status
