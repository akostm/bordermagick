# Test: rows, spans, a rule, an auto bottom band, fw units, wrapping columns, a top band
[layout]
name = grid

[frame]
padding    = 6pw 6pw auto 6pw
background = #F6F5F1
font       = 2.2fw HelveticaNeue-Medium
color      = contrast

[top]
columns = 1fr

[text number]
cell    = top 1
justify = end
content = No. {frame}

[bottom]
columns     = 28% 44% 28%
rows        = auto auto auto
row-gap     = 2.2fw
padding     = 4.5fw 0 6pw 0
align-items = start

[text title]
cell        = bottom 1-3/1
font        = 11fw HelveticaNeue-Bold
line-height = 0.82
content     = {title|city|filename} of the Ancient Greek World

[rule line]
cell      = bottom 1-3/2
thickness = 0.17fw

[text where]
cell        = bottom 1/3
line-height = 1.25
content     = {place|city}\n{date}

[text camera]
cell        = bottom 2/3
line-height = 1.25
content     = {body}\n{lens}

[text exposure]
cell        = bottom 3/3
line-height = 1.25
content     = {focal} ∙ {aperture}\n{shutter} ∙ {iso}
