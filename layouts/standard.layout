# The classic strip: a border with the title, place and date on the left, the maker's logo, camera, lens
# and exposure on the right. -b <colour>, the colour presets, two colours as a gradient and auto use it.
[layout]
name        = standard
category    = Solid
description = Plain or gradient border with title, place and camera info

[frame]
padding    = 3pmin 3pmin 13pmin
background = $border
texture    = paper $paper
font       = 1.7pmin DIN Alternate
color      = auto

[bottom]
columns = 1fr 1fr

# Baselines measured up from the bottom edge; the title's top lines up with the logo's top, and the
# place/date line shares a baseline with the exposure line
[text title]
cell           = bottom 1
position       = absolute
left           = 0
bottom         = 6.6pmin
vertical-align = baseline
font-size      = 4pmin
content        = {title|city|filename}

[text sub]
cell           = bottom 1
position       = absolute
left           = 0
bottom         = 3.6pmin
vertical-align = baseline
color          = auto-dim
content        = {place} ∙ {date}

# Wide wordmarks are 1.8pmin tall; squarer logos grow up to 1.6x
[logo maker]
cell     = bottom 2
position = absolute
right    = 0
bottom   = 8.8pmin
height   = 1.8pmin

[text camera]
cell           = bottom 2
position       = absolute
right          = 0
bottom         = 6.2pmin
vertical-align = baseline
content        = {model} ∙ {lens}

[text exposure]
cell           = bottom 2
position       = absolute
right          = 0
bottom         = 3.6pmin
vertical-align = baseline
color          = auto-dim
content        = {exposure}
